{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rendered memos (script output)",
  "type": "object",
  "required": [
    "memos_dir",
    "memos"
  ],
  "properties": {
    "memos_dir": {
      "type": "string",
      "minLength": 1
    },
    "memos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "memo_id",
          "file",
          "kind",
          "invoice",
          "disposition",
          "item",
          "batch_id",
          "session_id"
        ],
        "properties": {
          "disposition": {
            "enum": [
              "dispute",
              "escalate"
            ]
          },
          "kind": {
            "enum": [
              "line",
              "finding"
            ]
          }
        }
      }
    }
  }
}
