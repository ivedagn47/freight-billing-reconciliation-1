{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memo batches (script output)",
  "type": "object",
  "required": [
    "batch_size",
    "memos",
    "batches"
  ],
  "properties": {
    "batch_size": {
      "type": "integer",
      "minimum": 1
    },
    "memos": {
      "type": "integer",
      "minimum": 0
    },
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "batch_id",
          "packet",
          "memo_ids",
          "inputs"
        ],
        "properties": {
          "batch_id": {
            "type": "string",
            "minLength": 1
          },
          "packet": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "memo_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
