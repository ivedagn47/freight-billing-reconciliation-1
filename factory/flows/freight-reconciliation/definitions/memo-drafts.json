{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memo drafts (agent output)",
  "description": "Prose for each memo in a batch. The facts table of every memo is generated by code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_session_id",
    "batch_id",
    "memos"
  ],
  "properties": {
    "_session_id": {
      "type": "string",
      "minLength": 1
    },
    "batch_id": {
      "type": "string",
      "pattern": "^memo-[0-9]{3,}$"
    },
    "memos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "memo_id",
          "headline",
          "summary",
          "contract_basis",
          "action"
        ],
        "properties": {
          "memo_id": {
            "type": "string",
            "minLength": 1
          },
          "headline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          },
          "contract_basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
