{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adjudication decisions (agent output)",
  "description": "One decision per open item in a batch. There are no amount fields: amounts come only from pricing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_session_id",
    "batch_id",
    "decisions"
  ],
  "properties": {
    "_session_id": {
      "type": "string",
      "minLength": 1
    },
    "batch_id": {
      "type": "string",
      "pattern": "^adj-[0-9]{3,}$"
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "disposition",
          "clauses",
          "justification"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "accept",
              "dispute",
              "escalate"
            ]
          },
          "clauses": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(header|[0-9]+)$"
            }
          },
          "justification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    }
  }
}
