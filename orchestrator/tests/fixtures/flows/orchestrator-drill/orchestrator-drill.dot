// orchestrator/tests/fixtures/flows/orchestrator-drill/orchestrator-drill.dot
// Deterministic drill for the graph-orchestrator skill (not a product flow).
//   start -> plan -> fan -> [work] per step -> merge -> finish -> done
// With the fake workers in orchestrator/tests/fixtures/fake/orchestrator-drill/ it hits two
// recoverable failures on the way to done: plan writes too few steps (validation_failed at the top
// level), and the branch for step "sort-tools" writes "done": "yes" (validation_failed in a branch).

digraph orchestrator_drill {
  graph [label="Orchestrator drill"]

  start  [shape=Mdiamond]

  plan   [shape=box,
          prompt_template="prompts/plan.md",
          working_dir="{_run_artefact_dir}",
          output_schema="plan_outputs",
          model="haiku",
          permission_mode="auto",
          description="Agent: writes a plan of 3 to 5 step names for the goal."]

  fan    [runner=dynamic_fanout,
          items="steps",
          max_parallel=3,
          description="One branch per plan step."]

  work   [shape=box,
          prompt_template="prompts/work.md",
          working_dir="{_run_artefact_dir}",
          output_schema="work_outputs",
          model="haiku",
          permission_mode="auto",
          description="Agent: reports one step as done."]

  merge  [runner=join,
          description="Waits for every step branch."]

  finish [shape=box,
          runner=script,
          script="scripts/finish.sh",
          working_dir="{_run_artefact_dir}",
          output_schema="finish_outputs",
          description="Counts the merged step reports."]

  done   [shape=Msquare]

  start  -> plan
  plan   -> fan [gates="gates/plan-steps-unique.sh"]
  fan    -> work
  work   -> merge
  merge  -> finish
  finish -> done
}
